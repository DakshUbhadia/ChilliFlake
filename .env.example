# Required environment variables for ChilliFlake.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is already in .gitignore.

# Fine-grained GitHub Personal Access Token.
# Grant the source repository "Actions: read" and "Metadata: read" only.
# A classic token can read public artifacts, but fine-grained least privilege is preferred.
GITHUB_TOKEN=your_github_personal_access_token_here

# Path to the SQLite database file (relative to project root).
DB_PATH=db/chilliflake.db
