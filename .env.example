# Required environment variables for ChilliFlake.
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is already in .gitignore.

# GitHub Personal Access Token.
# Required scope: public_repo (read-only access to public repo Actions artifacts).
# No other scopes are needed. Do NOT grant broader permissions.
# Create one at: https://github.com/settings/tokens?scopes=public_repo
GITHUB_TOKEN=your_github_pat_here

# Path to the SQLite database file (relative to project root).
DB_PATH=db/chilliflake.db
